# Kimi K3 API
KIMI_API_KEY=your-kimi-api-key
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k3

# 得到大脑 API（可选）
DEDAO_BRAIN_API_KEY=your-dedao-brain-api-key
DEDAO_BRAIN_BASE_URL=https://api.example.com

# 内容生产 Agent 配置
CUA_RUNTIME_DIR=.runtime
CUA_DEFAULT_ACCOUNT=enterprise-ai
CUA_MAX_REVIEW_ROUNDS=3

# 知识库路径（多个路径用逗号分隔）
CUA_KNOWLEDGE_PATHS=/path/to/your/knowledge
