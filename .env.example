# Kimi K3 API
KIMI_API_KEY=your-kimi-api-key
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k3

# Get笔记（biji.com）API（可选）
# 个人开发者模式：只需要 API Key + Client ID
GETNOTE_API_KEY=gk_live_xxx
GETNOTE_CLIENT_ID=cli_xxx
GETNOTE_BASE_URL=https://openapi.biji.com/open

# Get笔记企业代授权模式（可选）：还需要 Grant ID
GETNOTE_GRANT_ID=grt_xxx

# 内容生产 Agent 配置
CUA_RUNTIME_DIR=.runtime
CUA_DEFAULT_ACCOUNT=enterprise-ai
CUA_MAX_REVIEW_ROUNDS=3

# 知识库路径（多个路径用逗号分隔）
CUA_KNOWLEDGE_PATHS=/path/to/your/knowledge
